#!/usr/bin/env bash
# brew-usage - Homebrew Disk Usage Analyzer
# Shows disk usage information for installed Homebrew packages

set -euo pipefail

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# Source library functions
LIB_DIR="$SCRIPT_DIR/lib"

# Handle Homebrew installation paths
# Only resolve the tap prefix when running from an installed location;
# a dev checkout (script dir contains lib/) always uses its own libs
if [[ ! -d "$SCRIPT_DIR/lib" ]] && command -v brew &>/dev/null; then
    # Try to use brew prefix if available (only if brew-usage is installed via tap)
    BREW_PREFIX_LIB="$(brew --prefix brew-usage 2>/dev/null || true)"
    # Only use brew prefix if it's a valid absolute path (not just "/lib")
    if [[ -n "$BREW_PREFIX_LIB" && "$BREW_PREFIX_LIB" != "/lib" && -d "$BREW_PREFIX_LIB/lib" ]]; then
        LIB_DIR="$BREW_PREFIX_LIB/lib"
    fi
fi

readonly LIB_DIR

# Source modules
source "$LIB_DIR/brew-usage-config.sh"
source "$LIB_DIR/brew-usage-utils.sh"
source "$LIB_DIR/brew-usage-scan.sh"
source "$LIB_DIR/brew-usage-calculate.sh"
source "$LIB_DIR/brew-usage-display.sh"
source "$LIB_DIR/brew-usage-size.sh"
source "$LIB_DIR/brew-usage-json.sh"
source "$LIB_DIR/brew-usage-cache.sh"

# Default options (from lib/brew-usage-config.sh)
SHOW_FORMULAE=$DEFAULT_SHOW_FORMULAE
SHOW_CASKS=$DEFAULT_SHOW_CASKS
TOP_N=$DEFAULT_TOP_N
USE_COLOR=$DEFAULT_COLOR_OUTPUT

# Size mode options
SIZE_MODE=false
declare -a SIZE_PACKAGES=()

# JSON output mode (report and size modes)
JSON_OUTPUT=false

# Cache analysis mode (-C/--cache)
CACHE_MODE=false

# Track explicitly-passed flags for order-independent mutual exclusivity checks
FORMULAE_FLAG_PASSED=false
CASKS_FLAG_PASSED=false
TOP_FLAG_PASSED=false
SORT_FLAG_PASSED=false
CACHE_FLAG_PASSED=false

# Function to show usage
usage() {
    display_help
}

# Function to show version
show_version() {
    display_version
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help|help)
            usage
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -f|--formulae)
            SHOW_CASKS=false
            FORMULAE_FLAG_PASSED=true
            shift
            ;;
        -c|--casks)
            SHOW_FORMULAE=false
            CASKS_FLAG_PASSED=true
            shift
            ;;
        -t|--top)
            if [[ -n "${2:-}" && "$2" =~ ^[0-9]+$ ]]; then
                TOP_N="$2"
                TOP_FLAG_PASSED=true
                shift 2
            else
                log_error "Argument for --top must be a number"
                exit 1
            fi
            ;;
        -s|--sort)
            if [[ -n "${2:-}" ]]; then
                case "$2" in
                    size|name)
                        SORT_FLAG_PASSED=true
                        shift 2
                        ;;
                    *)
                        log_error "Invalid sort order: $2 (use 'size' or 'name')"
                        exit 1
                        ;;
                esac
            else
                log_error "Argument for --sort required"
                exit 1
            fi
            ;;
        --size)
            SIZE_MODE=true
            shift
            # Collect package names (all remaining arguments are packages)
            while [[ -n "${1:-}" && ! "$1" =~ ^- ]]; do
                SIZE_PACKAGES+=("$1")
                shift
            done
            ;;
        -C|--cache)
            CACHE_MODE=true
            CACHE_FLAG_PASSED=true
            shift
            ;;
        --json)
            JSON_OUTPUT=true
            # JSON implies no color/decorations in the output stream
            USE_COLOR=false
            shift
            ;;
        --no-color)
            USE_COLOR=false
            shift
            ;;
        -*)
            log_error "Unknown option: $1"
            usage >&2
            exit 1
            ;;
        *)
            # Bare words after --size are packages, even when flags
            # (e.g. --json) appear between --size and the package names
            if $SIZE_MODE; then
                SIZE_PACKAGES+=("$1")
                shift
            else
                log_error "Unexpected argument: $1"
                usage >&2
                exit 1
            fi
            ;;
    esac
done

# Order-independent mutual exclusivity: --size vs report mode flags
if $SIZE_MODE; then
    conflict=""
    if $TOP_FLAG_PASSED; then
        conflict="--top"
    elif $FORMULAE_FLAG_PASSED; then
        conflict="--formulae"
    elif $CASKS_FLAG_PASSED; then
        conflict="--casks"
    elif $SORT_FLAG_PASSED; then
        conflict="--sort"
    elif $CACHE_FLAG_PASSED; then
        conflict="--cache"
    fi
    if [[ -n "$conflict" ]]; then
        log_error "--size is mutually exclusive with $conflict"
        exit 1
    fi
fi

# -C/--cache standalone: with no report flags passed, show only the cache
# section. Combined with any report flag (-f/-c/-t/-s), the cache section is
# appended to the report (PRD-001: third section, after Casks). The cache
# section is deliberately NOT part of the default report — only with -C.
if $CACHE_MODE && ! $FORMULAE_FLAG_PASSED && ! $CASKS_FLAG_PASSED && \
   ! $TOP_FLAG_PASSED && ! $SORT_FLAG_PASSED; then
    SHOW_FORMULAE=false
    SHOW_CASKS=false
fi

# Verify dependencies
if ! verify_dependencies; then
    exit 1
fi

# JSON output requires jq (report mode and size mode)
if $JSON_OUTPUT; then
    if ! json_verify_jq; then
        exit 1
    fi
fi

# Determine if we should use color (check if terminal)
if ! is_terminal; then
    USE_COLOR=false
fi

# Handle size mode (mutually exclusive with report mode)
if $SIZE_MODE; then
    # Check if jq is available for size mode
    if ! command -v jq >/dev/null 2>&1; then
        log_error "jq is required for --size mode. Install with: brew install jq"
        exit 1
    fi

    # If no packages specified, show help for size mode (or empty JSON)
    if [[ ${#SIZE_PACKAGES[@]} -eq 0 ]]; then
        if $JSON_OUTPUT; then
            printf '' | json_render_size_report
            exit 0
        fi
        cat << 'EOF'
Usage: brew-usage --size <package> [<package> ...]

Show download and installed sizes for Homebrew packages from bottle manifests.

Options:
  --size <package>  Show size for specified package(s)

Examples:
  brew-usage --size go              # Show size for go package
  brew-usage --size go node python  # Show sizes for multiple packages

For more information, visit: https://github.com/shrwnsan/brew-usage
EOF
        exit 0
    fi

    # Size mode: process packages and display sizes
    declare -a size_results=()
    declare -a failed_packages=()
    declare -a no_bottle_packages=()
    declare -a result_codes=()
    declare -a JSON_ENTRIES=()

    for package in "${SIZE_PACKAGES[@]}"; do
        # Capture return code safely; under set -e an unguarded command
        # substitution would abort the script before any results display.
        size_json=""
        result_code=0
        size_json=$(get_package_size "$package") || result_code=$?

        # Empty JSON with a zero exit code is still a failure for counting
        if [[ $result_code -eq 0 && -z "${size_json:-}" ]]; then
            result_code=1
        fi
        result_codes+=("$result_code")
        if [[ $result_code -eq 0 && -n "${size_json:-}" ]]; then
            size_results+=("$size_json")
            JSON_ENTRIES+=("$(json_size_entry_ok "$package" "$size_json")")
        elif [[ $result_code -eq 2 ]]; then
            # No bottle available (warning, not failure)
            no_bottle_packages+=("$package")
            JSON_ENTRIES+=("$(json_size_entry_failed "$package" "no_bottle")")
        else
            # Error (package not found or other failure)
            failed_packages+=("$package")
            JSON_ENTRIES+=("$(json_size_entry_failed "$package" "not_found")")
        fi
    done

    # PRD exit codes: 0 = all resolved (ok or warnings), 2 = partial success
    # (at least one ok/warning AND at least one failure), 1 = total failure.
    any_resolved=false
    any_failed=false
    for rc in "${result_codes[@]}"; do
        if [[ $rc -eq 0 || $rc -eq 2 ]]; then
            any_resolved=true
        else
            any_failed=true
        fi
    done
    if $any_failed; then
        if $any_resolved; then
            exit_code=2
        else
            exit_code=1
        fi
    else
        exit_code=0
    fi

    # JSON output path: valid JSON on stdout, warnings/errors on stderr only
    if $JSON_OUTPUT; then
        if [[ ${#no_bottle_packages[@]} -gt 0 ]]; then
            for pkg in "${no_bottle_packages[@]}"; do
                log_warning "No bottle available for '$pkg'"
            done
        fi
        if [[ ${#failed_packages[@]} -gt 0 ]]; then
            for pkg in "${failed_packages[@]}"; do
                log_error "Failed to get size for '$pkg'"
            done
        fi
        if [[ ${#JSON_ENTRIES[@]} -gt 0 ]]; then
            printf '%s\n' "${JSON_ENTRIES[@]}" | json_render_size_report
        else
            printf '' | json_render_size_report
        fi
        exit $exit_code
    fi

    # Display successful results
    if [[ ${#size_results[@]} -gt 0 ]]; then
        if [[ ${#size_results[@]} -eq 1 ]]; then
            # Single package: use detailed display
            display_package_size "${size_results[0]}" "$USE_COLOR"
        else
            # Multiple packages: use table display
            display_multiple_package_sizes size_results "$USE_COLOR"
        fi
    fi

    # Display warnings for packages with no bottle
    # (guard with length check: macOS ships bash 3.2, where expanding an
    # empty array with "${arr[@]}" under `set -u` raises 'unbound variable')
    if [[ ${#no_bottle_packages[@]} -gt 0 ]]; then
        for pkg in "${no_bottle_packages[@]}"; do
            display_no_bottle "$pkg" "$USE_COLOR"
        done
    fi

    # Display errors for failed packages
    if [[ ${#failed_packages[@]} -gt 0 ]]; then
        for pkg in "${failed_packages[@]}"; do
            display_size_error "Failed to get size for '$pkg'" "$USE_COLOR"
        done
    fi

    # Exit with appropriate code
    exit $exit_code
fi

# Display header (human output only; JSON stream has no decorations)
if ! $JSON_OUTPUT; then
    display_header "$USE_COLOR"
fi

# Grand total accumulator
GRAND_TOTAL=0

# Section JSON blocks (null = section not shown, key omitted from output)
FORMULAE_JSON_BLOCK=null
CASKS_JSON_BLOCK=null
CACHE_JSON_BLOCK=null

# Process one report section: scan -> sizes -> sort/filter -> display-or-JSON
# Input: $1 = section label, $2 = emoji, $3 = scan type, $4 = brew subdir
#        (Cellar/Caskroom), $5 = empty-state message
# Uses: $TOP_N, $USE_COLOR, $JSON_OUTPUT, $GRAND_TOTAL
# Sets globals: SECTION_JSON_BLOCK (JSON mode only), updates GRAND_TOTAL
# (bash 3.2-safe: no namerefs, no associative arrays)
report_process_section() {
    local label="$1"
    local emoji="$2"
    local scan_type="$3"
    local subdir="$4"
    local empty_message="$5"

    local entries=()
    local sorted=()
    local total=0
    local has_packages=false
    local names=""

    # Scan (names printed one per line; bash 3.2-safe)
    if names=$(scan_packages "$scan_type"); then
        if [[ -n "$names" ]]; then
            has_packages=true

            # Calculate sizes
            local brew_prefix base_path
            brew_prefix=$(brew --prefix)
            base_path="${brew_prefix}/${subdir}"

            local pkg pkg_path size_data
            while IFS= read -r pkg; do
                [[ -n "$pkg" ]] || continue
                pkg_path="${base_path}/${pkg}"
                if [[ -d "$pkg_path" ]]; then
                    if size_data=$(calculate_package_size "$pkg" "$pkg_path"); then
                        [[ -n "$size_data" ]] && entries+=("$size_data")
                    fi
                fi
            done <<< "$names"

            # Sort and filter
            if [[ ${#entries[@]} -gt 0 ]]; then
                while IFS= read -r entry; do
                    [[ -n "$entry" ]] && sorted+=("$entry")
                done < <(printf '%s\n' "${entries[@]}" | sort_by_size | filter_top_n "$TOP_N")
            fi

            # Calculate total
            if [[ ${#sorted[@]} -gt 0 ]]; then
                total=$(printf '%s\n' "${sorted[@]}" | calculate_total_size)
            fi
        fi
    else
        log_error "Failed to scan $scan_type"
    fi

    GRAND_TOTAL=$((GRAND_TOTAL + total))

    if $JSON_OUTPUT; then
        # Build JSON section block from collected entries
        SECTION_JSON_BLOCK=$({
            if [[ ${#sorted[@]} -gt 0 ]]; then
                printf '%s\n' "${sorted[@]}"
            fi
        } | json_section_block "$total")
    else
        display_section_header "$label" "$emoji" "$USE_COLOR"

        if $has_packages; then
            # Display
            local entry name bytes human color reset
            for entry in "${sorted[@]}"; do
                name=$(echo "$entry" | cut -d'|' -f1)
                bytes=$(echo "$entry" | cut -d'|' -f2)
                human=$(echo "$entry" | cut -d'|' -f3)

                color=$(get_size_color "$bytes" "$USE_COLOR")
                reset=$(get_color_code "reset" "$USE_COLOR")

                printf "${color}%8s${reset}  %s\n" "$human" "$name"
            done

            display_section_total "$total" "$USE_COLOR"
        else
            display_empty_state "$empty_message" "$USE_COLOR"
        fi
    fi
}

# Process formulae
if $SHOW_FORMULAE; then
    report_process_section "Formulae (Cellar)" "📦" "formulae" "Cellar" "No formulae found"
    $JSON_OUTPUT && FORMULAE_JSON_BLOCK=$SECTION_JSON_BLOCK
fi

# Process casks
if $SHOW_CASKS; then
    report_process_section "Casks (Caskroom)" "📱" "casks" "Caskroom" "No casks found"
    $JSON_OUTPUT && CASKS_JSON_BLOCK=$SECTION_JSON_BLOCK
fi

# Cache section (-C/--cache), after Casks per PRD-001 output format.
# Grand-total decision: when the cache section is shown, its bytes ARE
# included in the grand total — the PRD-001 JSON schema counts cache in
# grand_total_bytes, and the human grand total is kept consistent with the
# JSON. Without -C the grand total remains formulae+casks only.
if $CACHE_MODE; then
    if cache_analyze; then
        GRAND_TOTAL=$((GRAND_TOTAL + CACHE_TOTAL_BYTES))
        if $JSON_OUTPUT; then
            CACHE_JSON_BLOCK=$(json_cache_block \
                "$CACHE_TOTAL_BYTES" "$CACHE_CLEANUP_BYTES" "$CACHE_FILE_COUNT")
        else
            display_section_header "Cache (Homebrew downloads)" "🗑️" "$USE_COLOR"
            display_cache_section \
                "$CACHE_TOTAL_BYTES" "$CACHE_DOWNLOADS_BYTES" "$CACHE_OTHER_BYTES" \
                "$CACHE_FILE_COUNT" "$CACHE_CLEANUP_BYTES" "$CACHE_CLEANUP_COUNT" \
                "$CACHE_CLEANUP_DAYS" "$USE_COLOR"
        fi
    else
        log_error "Failed to analyze Homebrew cache"
    fi
fi

# Final output: JSON document or human grand total
if $JSON_OUTPUT; then
    json_render_report "$FORMULAE_JSON_BLOCK" "$CASKS_JSON_BLOCK" "$CACHE_JSON_BLOCK" "$GRAND_TOTAL"
else
    display_grand_total "$GRAND_TOTAL" "$USE_COLOR"
fi

exit 0
